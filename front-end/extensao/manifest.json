{
  "manifest_version": 3,
  "name": "EasyEnglish",
  "version": "2.0.1",
  "description": "Salva frases e traduções em flashcards direto do navegador.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["*://*.youtube.com/*", "*://*/*"],
  "action": {
    "default_popup": "pagina_flashcards/popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["captura_legendas_automatico/page_reader.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["captura_legendas_automatico/content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "captura_legendas_automatico/background.js"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
