# ============================================================
# Modelo de configuração — copie para .env e ajuste os valores
#   Desenvolvimento: DEBUG=True e sem DATABASE_URL (usa SQLite)
#   Produção:        DEBUG=False e DATABASE_URL apontando para o MySQL
# ============================================================

DEBUG=False
SECRET_KEY=gere-uma-chave-segura-e-cole-aqui
ALLOWED_HOSTS=seudominio.com,www.seudominio.com

# Produção: MySQL (formato: mysql://usuario:senha@host:porta/banco)
DATABASE_URL=mysql://easyenglish_user:sua_senha@localhost:3306/easyenglish
